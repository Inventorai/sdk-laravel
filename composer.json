{
    "name": "inventorai/laravel",
    "description": "Laravel integration for the Inventorai SDK",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inventorai/sdk": "^1.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "phpstan/phpstan": "^1.10|^2.0",
        "larastan/larastan": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Inventorai\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inventorai\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Inventorai\\Laravel\\InventoraiServiceProvider"
            ],
            "aliases": {
                "Inventorai": "Inventorai\\Laravel\\Facades\\Inventorai"
            }
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Inventorai/sdk-php.git"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
